"primaryColorText",
s.primary_color
);

setValue(
"accentColor",
s.accent_color
);

setValue(
"accentColorText",
s.accent_color
);

setValue(
"backgroundColor",
s.background_color
);

setValue(
"backgroundColorText",
s.background_color
);

setValue(
"borderColor",
s.border_color
);

setValue(
"borderColorText",
s.border_color
);

setValue(
"desktopColumns",
s.desktop_columns
);

setValue(
"cardRadius",
s.card_radius
);

