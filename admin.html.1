/* =====================================================
   SAVE THEME
===================================================== */

async function saveTheme(){

const payload = {

id:1,

primary_color:
document
.getElementById("primaryColorText")
.value
.trim(),

accent_color:
document
.getElementById("accentColorText")
.value
.trim(),

background_color:
document
.getElementById("backgroundColorText")
.value
.trim(),

border_color:
document
.getElementById("borderColorText")
.value
.trim(),

desktop_columns:
Number(
document
.getElementById("desktopColumns")
.value
),

card_radius:
Number(
document
.getElementById("cardRadius")
.value
),

product_gap:
Number(
document
.getElementById("productGap")
.value
),

hero_image_url:
document
.getElementById("heroImage")
.value
.trim(),

hero_label:
document
.getElementById("heroLabel")
.value
.trim(),

hero_title:
document
.getElementById("heroTitle")
.value
.trim(),

hero_description:
document
.getElementById("heroDescription")
.value
.trim()

};


const {
error
} =
await db
.from("store_settings")
.upsert(
payload,
{
onConflict:"id"
}
);


if(error){

toast(
"Gagal menyimpan tema: "+
error.message,
"error"
);

return;

}


settings =
{
...settings,
...payload
};


toast(
"Tampilan toko berhasil diperbarui.",
"success"
);


/*
   Buka toko untuk melihat perubahan.
*/

}


/* =====================================================
   COLOR SYNC
===================================================== */

const colorPairs = [

["primaryColor","primaryColorText"],

["accentColor","accentColorText"],

["backgroundColor","backgroundColorText"],

["borderColor","borderColorText"]

];


colorPairs.forEach(
([color,text])=>{

document
.getElementById(color)
.addEventListener(
"input",
function(){

document
.getElementById(text)
.value =
this.value;

}
);


document
.getElementById(text)
.addEventListener(
"input",
function(){

if(/^#[0-9A-Fa-f]{6}$/.test(this.value)){

document
.getElementById(color)
.value =
this.value;

}

}
);

}
);


