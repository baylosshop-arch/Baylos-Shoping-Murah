<!DOCTYPE html>
<html lang="id">
<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Baylos Admin V4</title>

<link rel="preconnect"
href="https://fonts.googleapis.com">

<link rel="preconnect"
href="https://fonts.gstatic.com"
crossorigin>

<link
href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script src="config.js"></script>

<style>

:root{
    --primary:#172033;
    --gold:#c9a45c;
    --bg:#f5f3ef;
    --white:#fff;
    --line:#e6e0d6;
    --danger:#c0392b;
    --success:#16835b;
    --muted:#747985;
}

*{
    box-sizing:border-box;
}

body{
    margin:0;
    background:var(--bg);
    color:var(--primary);
    font-family:"DM Sans",sans-serif;
}

button,
input,
textarea,
select{
    font-family:inherit;
}

button{
    cursor:pointer;
}

.hidden{
    display:none!important;
}

/* =========================
   LOGIN
========================= */

.login-screen{
    min-height:100vh;

    display:flex;
    align-items:center;
    justify-content:center;

    padding:20px;

    background:
    radial-gradient(
        circle at top,
        #27334b,
        #101827 70%
    );
}

.login-box{
    width:100%;
    max-width:430px;

    background:white;

    padding:35px;

    border-radius:25px;

    box-shadow:
    0 30px 80px rgba(0,0,0,.25);
}

.login-logo{
    text-align:center;
    margin-bottom:28px;
}

.login-logo h1{
    margin:0;

    font-family:"Playfair Display",serif;

    letter-spacing:4px;

    font-size:35px;
}

.login-logo p{
    margin:4px 0 0;

    font-size:10px;

    letter-spacing:3px;

    color:var(--gold);

    font-weight:bold;
}

.form-group{
    margin-bottom:16px;
}

.form-group label{
    display:block;

    margin-bottom:7px;

    font-size:12px;

    font-weight:700;
}

.form-group input,
.form-group textarea,
.form-group select{
    width:100%;

    padding:12px 14px;

    border:1px solid var(--line);

    border-radius:11px;

    outline:none;

    background:#faf9f7;

    font-size:14px;
}

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus{
    border-color:var(--gold);

    background:white;
}

.form-group textarea{
    min-height:100px;

    resize:vertical;
}

.login-btn{
    width:100%;

    padding:13px;

    border:0;

    border-radius:12px;

    background:var(--primary);

    color:white;

    font-weight:700;

    font-size:14px;
}

.login-btn:hover{
    opacity:.92;
}

.error{
    margin-top:12px;

    padding:10px;

    border-radius:10px;

    background:#fff0ef;

    color:var(--danger);

    font-size:12px;
}

/* =========================
   LAYOUT
========================= */

.app{
    display:flex;

    min-height:100vh;
}

/* SIDEBAR */

.sidebar{
    width:250px;

    position:fixed;

    left:0;
    top:0;
    bottom:0;

    background:var(--primary);

    color:white;

    padding:25px 16px;

    overflow-y:auto;
}

.brand{
    padding:5px 10px 25px;

    border-bottom:1px solid #ffffff18;
}

.brand h2{
    font-family:"Playfair Display",serif;

    letter-spacing:3px;

    margin:0;
}

.brand span{
    color:var(--gold);

    font-size:9px;

    letter-spacing:2px;
}

.menu{
    margin-top:20px;
}

.menu button{
    width:100%;

    text-align:left;

    border:0;

    background:transparent;

    color:#d9dee7;

    padding:13px;

    border-radius:10px;

    margin-bottom:5px;

    font-size:13px;
}

.menu button:hover,
.menu button.active{
    background:#ffffff12;

    color:white;
}

.logout{
    margin-top:20px!important;

    color:#ffaaa2!important;
}

/* CONTENT */

.content{
    margin-left:250px;

    width:calc(100% - 250px);

    min-height:100vh;
}

.topbar{
    position:sticky;

    top:0;

    z-index:20;

    background:#fffffff2;

    backdrop-filter:blur(15px);

    border-bottom:1px solid var(--line);

    padding:18px 25px;

    display:flex;

    justify-content:space-between;

    align-items:center;
}

.topbar h1{
    margin:0;

    font-family:"Playfair Display",serif;

    font-size:27px;
}

.user-email{
    color:var(--muted);

    font-size:12px;
}

.page{
    padding:25px;
}

/* =========================
   CARDS
========================= */

.stats{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:15px;

    margin-bottom:25px;
}

.stat{
    background:white;

    border:1px solid var(--line);

    border-radius:18px;

    padding:20px;
}

.stat small{
    color:var(--muted);
}

.stat strong{
    display:block;

    font-size:30px;

    margin-top:5px;
}

.panel{
    background:white;

    border:1px solid var(--line);

    border-radius:20px;

    padding:20px;

    margin-bottom:20px;
}

.panel-header{
    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:15px;

    margin-bottom:18px;
}

.panel-header h2{
    margin:0;

    font-family:"Playfair Display",serif;

    font-size:23px;
}

/* =========================
   BUTTON
========================= */

.btn{
    border:0;

    border-radius:10px;

    padding:10px 15px;

    font-weight:700;

    font-size:12px;
}

.btn-primary{
    background:var(--primary);

    color:white;
}

.btn-gold{
    background:var(--gold);

    color:var(--primary);
}

.btn-danger{
    background:#fff0ee;

    color:var(--danger);
}

.btn-secondary{
    background:#f0eee9;

    color:var(--primary);
}

/* =========================
   PRODUCTS TABLE
========================= */

.table-wrap{
    overflow-x:auto;
}

table{
    width:100%;

    border-collapse:collapse;

    min-width:750px;
}

th{
    text-align:left;

    font-size:11px;

    color:var(--muted);

    padding:12px;

    border-bottom:1px solid var(--line);
}

td{
    padding:12px;

    border-bottom:1px solid var(--line);

    font-size:12px;

    vertical-align:middle;
}

.product-thumb{
    width:55px;

    height:55px;

    object-fit:cover;

    border-radius:10px;

    background:#eee;
}

.actions{
    display:flex;

    gap:5px;

    flex-wrap:wrap;
}

.badge{
    display:inline-block;

    padding:5px 8px;

    border-radius:20px;

    font-size:9px;

    font-weight:bold;
}

/* =========================
   FORM
========================= */

.form-grid{
    display:grid;

    grid-template-columns:
    repeat(2,1fr);

    gap:15px;
}

.full{
    grid-column:1/-1;
}

.form-actions{
    display:flex;

    justify-content:flex-end;

    gap:10px;

    margin-top:20px;
}

/* =========================
   UPLOAD
========================= */

.upload-box{
    border:2px dashed var(--line);

    border-radius:15px;

    padding:20px;

    text-align:center;

    background:#faf9f7;
}

.upload-box input{
    margin-top:10px;
}

.preview{
    width:120px;

    height:120px;

    object-fit:cover;

    border-radius:15px;

    margin:15px auto;

    display:none;
}

/* =========================
   THEME
========================= */

.color-input{
    display:flex;

    align-items:center;

    gap:10px;
}

.color-input input[type=color]{
    width:55px;

    height:42px;

    padding:3px;
}

/* =========================
   TOAST
========================= */

.toast{
    position:fixed;

    right:20px;
    bottom:20px;

    z-index:9999;

    max-width:350px;

    padding:13px 17px;

    border-radius:12px;

    background:var(--primary);

    color:white;

    box-shadow:0 15px 40px #0003;

    font-size:12px;

    transform:translateY(100px);

    opacity:0;

    transition:.25s;
}

.toast.show{
    transform:translateY(0);

    opacity:1;
}

.toast.success{
    background:var(--success);
}

.toast.error{
    background:var(--danger);
}

/* =========================
   MOBILE
========================= */

.mobile-menu{
    display:none;
}

@media(max-width:800px){

    .sidebar{
        transform:translateX(-100%);

        transition:.25s;

        z-index:100;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .content{
        margin-left:0;

        width:100%;
    }

    .mobile-menu{
        display:block;

        border:0;

        background:transparent;

        font-size:23px;
    }

    .stats{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }

    .page{
        padding:15px;
    }

    .topbar{
        padding:15px;
    }

    .topbar h1{
        font-size:21px;
    }

}

/* =========================
   LOADING
========================= */

.loading{
    text-align:center;

    padding:40px;

    color:var(--muted);
}

</style>

</head>

<body>


<!-- =========================
     LOGIN
