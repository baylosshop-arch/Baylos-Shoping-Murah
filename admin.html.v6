<!doctype html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#111827">
<title>BAYLOS Admin Pro</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="config.js"></script>
<style>
:root{--navy:#111827;--gold:#c9a45c;--bg:#f6f3ed;--card:#fff;--line:#e7e0d5;--muted:#737987;--danger:#b42318;--green:#16835b;--orange:#e85d3f}
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:var(--bg);color:#172033}button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}
.topbar{height:70px;background:var(--navy);color:#fff;display:flex;align-items:center;padding:0 22px;gap:15px;position:sticky;top:0;z-index:20}.brand{font-weight:900;letter-spacing:1.5px}.brand small{display:block;font-size:9px;color:#d9bd7d;letter-spacing:2px}.user{margin-left:auto;font-size:12px;opacity:.8}.menu{display:none;background:none;border:0;color:#fff;font-size:25px}
.layout{display:flex;min-height:calc(100vh - 70px)}.sidebar{width:235px;background:#fff;border-right:1px solid var(--line);padding:18px 12px;flex:none}.nav{display:grid;gap:7px}.nav button{border:0;background:transparent;text-align:left;padding:12px;border-radius:11px;color:#4b5563;font-weight:700}.nav button.active,.nav button:hover{background:#f1eadc;color:#8b6a32}.logout{color:#a33!important;margin-top:18px!important}
.content{flex:1;max-width:1500px;margin:auto;padding:25px;width:100%}.page{display:none}.page.active{display:block}.head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:20px}.head h1{margin:0;font-size:25px}.head p{margin:5px 0;color:var(--muted);font-size:13px}
.btn{border:0;border-radius:11px;padding:11px 15px;font-weight:800}.primary{background:var(--navy);color:#fff}.gold{background:var(--gold);color:#fff}.secondary{background:#eee9df;color:#374151}.danger{background:#fee4e2;color:var(--danger)}
.card{background:#fff;border:1px solid var(--line);border-radius:17px;padding:20px;margin-bottom:18px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-bottom:18px}.stat{background:#fff;border:1px solid var(--line);border-radius:17px;padding:18px}.stat small{color:var(--muted)}.stat strong{display:block;font-size:28px;margin-top:7px}
.periods{display:flex;gap:8px;overflow:auto}.period{border:1px solid #ddd;background:#f5f3ef;padding:10px 15px;border-radius:10px;font-weight:800;white-space:nowrap}.period.active{border:2px solid var(--orange);color:var(--orange);background:#fff}
.perf-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.perf{background:#fff;border:1px solid #eee8df;border-radius:16px;padding:17px}.perf small{color:#666}.perf strong{display:block;font-size:28px;margin:10px 0 5px}.perf span{font-size:11px;color:#999}
.two{display:grid;grid-template-columns:1fr 1fr;gap:18px}.chart{height:240px;display:flex;align-items:end;gap:3px;padding:20px 5px 25px;border-bottom:1px solid #ddd;background:repeating-linear-gradient(to bottom,transparent 0,transparent 19%,#eee 20%)}.bar{flex:1;background:var(--orange);border-radius:5px 5px 0 0;min-width:3px}.bar:hover{opacity:.75}.labels{display:flex;justify-content:space-between;font-size:10px;color:#999}
.source{display:grid;gap:12px}.src{display:grid;grid-template-columns:105px 1fr 45px;gap:8px;align-items:center;font-size:12px}.progress{height:9px;background:#eee9df;border-radius:20px;overflow:hidden}.progress i{display:block;height:100%;background:var(--gold)}
.rank{display:grid;grid-template-columns:30px 1fr 65px 65px;gap:7px;padding:11px 0;border-bottom:1px solid #eee8df;font-size:12px}.rank b{color:#a17b38}.empty{text-align:center;padding:25px;color:#888;font-size:13px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.full{grid-column:1/-1}label{display:block;font-size:12px;font-weight:800;margin-bottom:7px}input,select,textarea{width:100%;border:1px solid #dcd5ca;border-radius:10px;padding:11px;background:#fff}textarea{min-height:100px}.actions,.tools{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.tools{margin:0}.search{max-width:350px}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;min-width:760px}.table th,.table td{padding:12px;border-bottom:1px solid #eee8df;text-align:left;font-size:12px}.thumb{width:58px;height:58px;object-fit:cover;border-radius:10px}.badge{padding:5px 8px;border-radius:20px;font-size:10px;font-weight:800}.on{background:#e7f7f0;color:#16835b}.off{background:#eee;color:#666}.preview{display:none;max-width:180px;max-height:180px;margin-top:10px;border-radius:12px}.color{display:flex;gap:8px}.color input[type=color]{width:55px;height:44px;padding:3px}.color input[type=text]{flex:1}
.login{min-height:100vh;display:grid;place-items:center;padding:20px}.login-card{width:min(430px,100%);background:#fff;border:1px solid var(--line);border-radius:24px;padding:30px}.login-logo{font-size:28px;font-weight:900;letter-spacing:3px}.login-sub{color:var(--gold);font-size:10px;letter-spacing:2px;font-weight:800;margin:4px 0 25px}.field{margin-bottom:14px}.note{font-size:12px;line-height:1.6;color:var(--muted)}
.toast{position:fixed;right:18px;bottom:18px;background:var(--navy);color:#fff;padding:13px 16px;border-radius:12px;opacity:0;pointer-events:none;transition:.2s;z-index:50}.toast.show{opacity:1}.toast.err{background:#9f1d16}
@media(max-width:1000px){.stats,.perf-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:850px){.menu{display:block}.sidebar{position:fixed;left:-250px;top:70px;bottom:0;z-index:15;transition:.2s}.sidebar.open{left:0}.content{padding:17px}.user{display:none}.two,.grid{grid-template-columns:1fr}}@media(max-width:520px){.stats,.perf-grid{grid-template-columns:1fr 1fr}.head{align-items:flex-start;flex-direction:column}.perf strong,.stat strong{font-size:23px}}
</style>
</head>
<body>
<div id="loginView" class="login"><div class="login-card">
<div class="login-logo">BAYLOS</div><div class="login-sub">ADMIN CONTROL CENTER</div>
<div class="field"><label>Email Admin</label><input id="loginEmail" type="email" placeholder="email@kamu.com"></div>
<div class="field"><label>Password</label><input id="loginPassword" type="password" placeholder="••••••••"></div>
<button class="btn primary" id="loginBtn" style="width:100%">Masuk ke Admin</button>
<p class="note">Login menggunakan Supabase Authentication.</p>
</div></div>

<div id="app" class="hidden"><header class="topbar"><button class="menu" id="menuBtn">☰</button><div class="brand">BAYLOS<small>ADMIN CONTROL CENTER</small></div><div class="user" id="userEmail"></div></header>
<div class="layout"><aside class="sidebar" id="sidebar"><nav class="nav">
<button class="active" data-page="dashboard">📊 Performa Toko</button><button data-page="products">🛍️ Produk</button><button data-page="add">➕ Tambah Produk</button><button data-page="theme">🎨 Tampilan Toko</button><button data-page="settings">⚙️ Pengaturan</button><button class="logout" id="logoutBtn">🚪 Keluar</button>
</nav></aside><main class="content">

<section id="page-dashboard" class="page active">
<div class="head"><div><h1>Performa Toko</h1><p>Statistik website affiliate Baylos.</p></div><div class="tools"><button class="btn secondary" id="refresh">↻ Refresh</button><button class="btn gold" data-page="add">+ Produk Baru</button></div></div>
<div class="card"><div class="head" style="margin:0"><div><b>Periode</b><div id="periodText" class="note">Real-time</div></div><div class="periods"><button class="period active" data-period="today">Real-time</button><button class="period" data-period="yesterday">Kemarin</button><button class="period" data-period="7">7 hari sebelumnya</button><button class="period" data-period="30">30 hari sebelumnya</button></div></div></div>

<div class="perf-grid">
<div class="perf"><small>Pengunjung</small><strong id="visitors">0</strong><span>pengunjung unik</span></div>
<div class="perf"><small>Tampilan Produk</small><strong id="views">0</strong><span>halaman/produk dilihat</span></div>
<div class="perf"><small>Klik Affiliate</small><strong id="clicks">0</strong><span>klik menuju marketplace</span></div>
<div class="perf"><small>Tingkat Klik</small><strong id="rate">0%</strong><span>klik per pengunjung</span></div>
</div>

<div class="two">
<div class="card"><div class="head" style="margin-bottom:8px"><div><h3 style="margin:0">Aktivitas Toko</h3><small id="chartTitle">Hari ini</small></div></div><div id="chart" class="chart"></div><div class="labels"><span>00:00</span><span>04:00</span><span>08:00</span><span>12:00</span><span>16:00</span><span>20:00</span><span>23:59</span></div></div>
<div class="card"><div class="head" style="margin-bottom:15px"><div><h3 style="margin:0">Sumber Kunjungan</h3><small>Asal pengunjung website</small></div></div><div id="sources" class="source"><div class="empty">Belum ada data.</div></div></div>
</div>

<div class="two">
<div class="card"><div class="head" style="margin-bottom:8px"><div><h3 style="margin:0">Kontribusi Produk</h3><small>Dilihat dan diklik</small></div></div><div class="rank" style="font-weight:bold;color:#777"><span>#</span><span>Produk</span><span>View</span><span>Klik</span></div><div id="ranking"><div class="empty">Belum ada data.</div></div></div>
<div class="card"><h3>Statistik Katalog</h3><div class="stats" style="grid-template-columns:1fr 1fr;margin:0"><div class="stat"><small>Total Produk</small><strong id="totalProducts">0</strong></div><div class="stat"><small>Produk Aktif</small><strong id="activeProducts">0</strong></div><div class="stat"><small>Kategori</small><strong id="categories">0</strong></div><div class="stat"><small>Promo</small><strong id="promos">0</strong></div></div></div>
</div>
<div class="card"><b>Catatan</b><p class="note">Baylos dapat mengukur kunjungan, tampilan produk, dan klik affiliate. Nilai penjualan/pesanan di marketplace tidak otomatis tersedia dari website affiliate.</p></div>
</section>

<section id="page-products" class="page"><div class="head"><div><h1>Produk</h1><p>Kelola katalog affiliate.</p></div><div class="tools"><input class="search" id="productSearch" placeholder="Cari nama/kategori..."><button class="btn primary" data-page="add">+ Tambah</button></div></div><div class="card"><div class="table-wrap"><table class="table"><thead><tr><th>Gambar</th><th>Produk</th><th>Kategori</th><th>Harga</th><th>Label</th><th>Status</th><th>Aksi</th></tr></thead><tbody id="productTable"></tbody></table></div></div></section>

<section id="page-add" class="page"><div class="head"><div><h1 id="formTitle">Tambah Produk</h1><p>Data masuk ke tabel products.</p></div><button class="btn secondary" data-page="products">← Kembali</button></div><div class="card"><form id="productForm"><input type="hidden" id="productId"><div class="grid">
<div><label>Nama Produk *</label><input id="productName" required></div><div><label>Kategori *</label><input id="productCategory" required></div><div><label>Harga</label><input id="productPrice" type="number"></div><div><label>Label</label><select id="productLabel"><option value="">Tanpa Label</option><option>PROMO</option><option>TERBARU</option><option>BEST SELLER</option></select></div>
<div class="full"><label>Link Affiliate *</label><input id="affiliateUrl" type="url" required></div><div class="full"><label>URL Gambar</label><input id="imageUrl" type="url"></div><div class="full"><label>Upload Gambar</label><input id="imageFile" type="file" accept="image/*"><img id="imagePreview" class="preview"></div><div class="full"><label>Deskripsi</label><textarea id="description"></textarea></div><div><label>Urutan</label><input id="sortOrder" type="number" value="0"></div><div><label>Status</label><select id="active"><option value="true">Aktif</option><option value="false">Nonaktif</option></select></div>
</div><div class="actions"><button type="button" class="btn secondary" id="reset">Reset</button><button class="btn primary" id="save">💾 Simpan Produk</button></div></form></div></section>

<section id="page-theme" class="page"><div class="head"><div><h1>Theme Studio</h1><p>Atur tampilan toko.</p></div><button class="btn gold" id="saveTheme">💾 Simpan Tampilan</button></div><div class="card"><div class="grid">
<div><label>Warna Utama</label><div class="color"><input id="primaryColor" type="color"><input id="primaryText"></div></div><div><label>Warna Aksen</label><div class="color"><input id="accentColor" type="color"><input id="accentText"></div></div><div><label>Background</label><div class="color"><input id="bgColor" type="color"><input id="bgText"></div></div><div><label>Border</label><div class="color"><input id="borderColor" type="color"><input id="borderText"></div></div><div><label>Kolom Desktop</label><select id="columns"><option>2</option><option>3</option><option selected>4</option><option>5</option></select></div><div><label>Radius Kartu</label><input id="radius" type="number"></div><div><label>Jarak Produk</label><input id="gap" type="number"></div><div class="full"><label>URL Banner</label><input id="heroImage" type="url"></div><div class="full"><label>Label Banner</label><input id="heroLabel"></div><div class="full"><label>Judul Banner</label><textarea id="heroTitle"></textarea></div><div class="full"><label>Deskripsi Banner</label><textarea id="heroDescription"></textarea></div>
</div></div></section>

<section id="page-settings" class="page"><div class="head"><div><h1>Pengaturan</h1><p>Akun dan keamanan.</p></div></div><div class="card"><label>Email Admin</label><input id="currentEmail" readonly><p class="note">Jangan pernah menaruh Service Role Key di GitHub.</p><button class="btn danger" id="logout2">🚪 Keluar</button></div></section>

</main></div></div><div id="toast" class="toast"></div>

<script>
const cfg=window.BAYLOS_CONFIG||{},db=supabase.createClient(cfg.SUPABASE_URL,cfg.SUPABASE_ANON_KEY);
let products=[],editingId=null,settings={},events=[],period="today";
const $=id=>document.getElementById(id),esc=v=>String(v??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
function toast(m,e=false){let t=$("toast");t.textContent=m;t.className="toast show"+(e?" err":"");clearTimeout(window.tt);window.tt=setTimeout(()=>t.className="toast",2500)}
function page(p){document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));$("page-"+p).classList.add("active");document.querySelectorAll(".nav button[data-page]").forEach(x=>x.classList.toggle("active",x.dataset.page===p));$("sidebar").classList.remove("open");if(p==="dashboard")loadAnalytics();if(p==="products")renderProducts();if(p==="theme")fillTheme()}
document.addEventListener("click",e=>{let b=e.target.closest("[data-page]");if(b)page(b.dataset.page)});$("menuBtn").onclick=()=>$("sidebar").classList.toggle("open");

async function loadProducts(){let r=await db.from("products").select("*").order("sort_order").order("created_at",{ascending:false});if(r.error){toast(r.error.message,true);return}products=r.data||[];updateCatalog();renderProducts()}
function updateCatalog(){$("totalProducts").textContent=products.length;$("activeProducts").textContent=products.filter(p=>p.is_active).length;$("categories").textContent=new Set(products.map(p=>p.category).filter(Boolean)).size;$("promos").textContent=products.filter(p=>String(p.label||"").toUpperCase()==="PROMO").length}
function renderProducts(){let q=($("productSearch")?.value||"").toLowerCase();let a=products.filter(p=>(p.name+" "+(p.category||"")).toLowerCase().includes(q));$("productTable").innerHTML=a.length?a.map(p=>`<tr><td><img class="thumb" src="${esc(p.image_url||"https://placehold.co/100?text=Baylos")}"></td><td><b>${esc(p.name)}</b><br><small>Urutan ${p.sort_order||0}</small></td><td>${esc(p.category||"-")}</td><td>Rp${Number(p.price||0).toLocaleString("id-ID")}</td><td>${esc(p.label||"-")}</td><td>${p.is_active?'<span class="badge on">AKTIF</span>':'<span class="badge off">NONAKTIF</span>'}</td><td><button class="btn secondary" onclick="editProduct('${esc(p.id)}')">Edit</button> <button class="btn danger" onclick="deleteProduct('${esc(p.id)}')">Hapus</button></td></tr>`).join(""):'<tr><td colspan="7">Tidak ada produk.</td></tr>'}
$("productSearch").oninput=renderProducts;
function resetForm(){editingId=null;$("productForm").reset();$("formTitle").textContent="Tambah Produk";$("active").value="true";$("sortOrder").value=0;$("imagePreview").style.display="none"}
function editProduct(id){let p=products.find(x=>x.id===id);if(!p)return;editingId=id;$("formTitle").textContent="Edit Produk";$("productName").value=p.name||"";$("productCategory").value=p.category||"";$("productPrice").value=p.price??"";$("productLabel").value=p.label||"";$("affiliateUrl").value=p.affiliate_url||"";$("imageUrl").value=p.image_url||"";$("description").value=p.description||"";$("sortOrder").value=p.sort_order||0;$("active").value=String(p.is_active);if(p.image_url){$("imagePreview").src=p.image_url;$("imagePreview").style.display="block"}page("add")}
$("reset").onclick=resetForm;
$("imageFile").onchange=e=>{let f=e.target.files[0];if(!f)return;if(f.size>5*1024*1024){toast("Maksimal 5 MB",true);e.target.value="";return}$("imagePreview").src=URL.createObjectURL(f);$("imagePreview").style.display="block"};
async function upload(f){let ext=(f.name.split(".").pop()||"jpg").toLowerCase(),path="products/"+Date.now()+"-"+Math.random().toString(36).slice(2)+"."+ext,r=await db.storage.from("product-images").upload(path,f,{upsert:false});if(r.error)throw r.error;return db.storage.from("product-images").getPublicUrl(path).data.publicUrl}
$("productForm").onsubmit=async e=>{e.preventDefault();let b=$("save");b.disabled=true;try{let image=$("imageUrl").value.trim(),f=$("imageFile").files[0];if(f)image=await upload(f);let p={name:$("productName").value.trim(),category:$("productCategory").value.trim(),price:$("productPrice").value?Number($("productPrice").value):null,label:$("productLabel").value,affiliate_url:$("affiliateUrl").value.trim(),image_url:image,description:$("description").value.trim(),sort_order:Number($("sortOrder").value||0),is_active:$("active").value==="true"};let r=editingId?await db.from("products").update(p).eq("id",editingId):await db.from("products").insert(p);if(r.error)throw r.error;toast("Produk tersimpan");await loadProducts();resetForm();page("products")}catch(x){toast(x.message,true)}finally{b.disabled=false}};
async function deleteProduct(id){let p=products.find(x=>x.id===id);if(!p||!confirm("Hapus "+p.name+"?"))return;let r=await db.from("products").delete().eq("id",id);if(r.error)toast(r.error.message,true);else{toast("Produk dihapus");loadProducts()}}

const DEF={primary_color:"#172033",accent_color:"#c9a45c",background_color:"#f7f5f1",border_color:"#e8e2d8",desktop_columns:4,card_radius:22,product_gap:18,hero_image_url:"",hero_label:"BAYLOS SHOPPING MURAH",hero_title:"Fashion Cantik. Harga Bersahabat.",hero_description:"Temukan produk pilihan Baylos."};
function fillTheme(){let s={...DEF,...settings},m=[["primaryColor",s.primary_color],["primaryText",s.primary_color],["accentColor",s.accent_color],["accentText",s.accent_color],["bgColor",s.background_color],["bgText",s.background_color],["borderColor",s.border_color],["borderText",s.border_color],["columns",s.desktop_columns],["radius",s.card_radius],["gap",s.product_gap],["heroImage",s.hero_image_url],["heroLabel",s.hero_label],["heroTitle",s.hero_title],["heroDescription",s.hero_description]];m.forEach(x=>$(x[0]).value=x[1]??"")}
["primary","accent","bg","border"].forEach(x=>$(x+"Color").oninput=()=>$(x+"Text").value=$(x+"Color").value);
async function loadSettings(){let r=await db.from("store_settings").select("*").eq("id",1).maybeSingle();settings={...DEF,...(r.data||{})};fillTheme()}
$("saveTheme").onclick=async()=>{let p={id:1,primary_color:$("primaryText").value,accent_color:$("accentText").value,background_color:$("bgText").value,border_color:$("borderText").value,desktop_columns:Number($("columns").value),card_radius:Number($("radius").value),product_gap:Number($("gap").value),hero_image_url:$("heroImage").value,hero_label:$("heroLabel").value,hero_title:$("heroTitle").value,hero_description:$("heroDescription").value};let r=await db.from("store_settings").upsert(p,{onConflict:"id"});toast(r.error?r.error.message:"Tampilan tersimpan",!!r.error)};

function start(){let n=new Date();n.setHours(0,0,0,0);if(period==="yesterday")n.setDate(n.getDate()-1);if(period==="7"||period==="30")n.setDate(n.getDate()-Number(period));return n}
function end(){let n=new Date();if(period==="yesterday"){n.setHours(0,0,0,0);return n}return n}
async function loadAnalytics(){let r=await db.from("analytics_events").select("session_id,event_type,product_id,product_name,source,created_at").gte("created_at",start().toISOString()).lt("created_at",end().toISOString()).order("created_at");if(r.error){toast("Analytics: "+r.error.message,true);events=[]}else events=r.data||[];renderAnalytics()}
function renderAnalytics(){let visitors=new Set(events.map(x=>x.session_id).filter(Boolean)).size,views=events.filter(x=>x.event_type==="product_view").length,clicks=events.filter(x=>x.event_type==="affiliate_click").length;$("visitors").textContent=visitors.toLocaleString("id-ID");$("views").textContent=views.toLocaleString("id-ID");$("clicks").textContent=clicks.toLocaleString("id-ID");$("rate").textContent=(visitors?(clicks/visitors*100).toFixed(1):"0")+"%";$("periodText").textContent=period==="today"?"Real-time":period==="yesterday"?"Kemarin":period+" hari sebelumnya";renderChart();renderSources();renderRanking()}
function renderChart(){let day=period==="today"||period==="yesterday",n=day?24:(period==="7"?7:30),a=Array(n).fill(0),s=start();events.forEach(e=>{let d=new Date(e.created_at),i=day?d.getHours():Math.floor((d-s)/86400000);if(i>=0&&i<n)a[i]++});let max=Math.max(...a,1);$("chart").innerHTML=a.map(v=>`<div class="bar" title="${v} aktivitas" style="height:${Math.max(2,v/max*100)}%"></div>`).join("");$("chartTitle").textContent=day?(period==="today"?"Hari ini":"Kemarin"):(period+" hari")}
function renderSources(){let m={};events.filter(e=>e.event_type==="page_view").forEach(e=>m[e.source||"Langsung"]=(m[e.source||"Langsung"]||0)+1);let t=Object.values(m).reduce((a,b)=>a+b,0),r=Object.entries(m).sort((a,b)=>b[1]-a[1]).slice(0,8);$("sources").innerHTML=r.length?r.map(x=>{let p=t?Math.round(x[1]/t*100):0;return `<div class="src"><span>${esc(x[0])}</span><div class="progress"><i style="width:${p}%"></i></div><b>${p}%</b></div>`}).join(""):'<div class="empty">Belum ada data.</div>'}
function renderRanking(){let m={};events.forEach(e=>{if(!e.product_id&&!e.product_name)return;let k=e.product_id||e.product_name;m[k]??={name:e.product_name||"Produk",v:0,c:0};if(e.event_type==="product_view")m[k].v++;if(e.event_type==="affiliate_click")m[k].c++});let r=Object.values(m).sort((a,b)=>b.v+b.c-a.v-a.c).slice(0,10);$("ranking").innerHTML=r.length?r.map((x,i)=>`<div class="rank"><b>${i+1}</b><span>${esc(x.name)}</span><span>${x.v}</span><span>${x.c}</span></div>`).join(""):'<div class="empty">Belum ada data produk.</div>'}
document.querySelectorAll(".period").forEach(b=>b.onclick=()=>{document.querySelectorAll(".period").forEach(x=>x.classList.remove("active"));b.classList.add("active");period=b.dataset.period;loadAnalytics()});$("refresh").onclick=()=>loadAnalytics();

async function login(){let email=$("loginEmail").value.trim(),password=$("loginPassword").value;if(!email||!password)return toast("Email dan password wajib diisi",true);let r=await db.auth.signInWithPassword({email,password});if(r.error)toast("Login gagal: "+r.error.message,true)}
async function logout(){await db.auth.signOut();location.reload()}$("loginBtn").onclick=login;$("loginPassword").onkeydown=e=>{if(e.key==="Enter")login()};$("logoutBtn").onclick=logout;$("logout2").onclick=logout;
async function boot(){let r=await db.auth.getSession();if(!r.data.session)return;$("loginView").classList.add("hidden");$("app").classList.remove("hidden");let e=r.data.session.user.email||"";$("userEmail").textContent=e;$("currentEmail").value=e;await Promise.all([loadProducts(),loadSettings(),loadAnalytics()])}
db.auth.onAuthStateChange((_e,s)=>{if(s)boot()});boot();
</script>
</body></html>
