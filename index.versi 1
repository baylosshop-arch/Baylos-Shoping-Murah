<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Baylos Shoping Murah</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="config.js"></script>

<style>

:root{
    --primary:#172033;
    --gold:#c9a45c;
    --bg:#f7f5f1;
    --white:#ffffff;
    --line:#e8e2d8;
    --text:#172033;
    --muted:#737985;
    --radius:22px;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--bg);
    color:var(--text);
    font-family:"DM Sans",sans-serif;
}

a{
    text-decoration:none;
    color:inherit;
}

button,
input{
    font-family:inherit;
}

/* =========================
   HEADER
========================= */

.header{
    position:sticky;
    top:0;
    z-index:1000;
    background:rgba(255,255,255,.94);
    backdrop-filter:blur(18px);
    border-bottom:1px solid var(--line);
}

.header-inner{
    max-width:1250px;
    margin:auto;
    min-height:74px;
    padding:10px 20px;

    display:flex;
    align-items:center;
    gap:20px;
}

.logo{
    min-width:180px;
}

.logo-main{
    font-family:"Playfair Display",serif;
    font-size:29px;
    font-weight:700;
    letter-spacing:3px;
}

.logo-sub{
    display:block;
    font-size:9px;
    font-weight:700;
    letter-spacing:3px;
    color:var(--gold);
    margin-top:-2px;
}

.search-box{
    flex:1;
    height:46px;

    display:flex;
    align-items:center;

    background:#f3f1ed;
    border:1px solid var(--line);
    border-radius:30px;
    overflow:hidden;
}

.search-box input{
    flex:1;
    height:100%;
    border:0;
    outline:none;
    background:transparent;
    padding:0 18px;
    font-size:14px;
}

.search-btn{
    width:55px;
    height:100%;
    border:0;
    background:var(--primary);
    color:#fff;
    cursor:pointer;
    font-size:19px;
}

/* =========================
   HERO
========================= */

.hero{
    max-width:1250px;
    margin:24px auto;
    padding:0 20px;
}

.hero-box{
    min-height:440px;

    border-radius:30px;

    background:
        linear-gradient(
            100deg,
            rgba(12,18,32,.95),
            rgba(12,18,32,.40)
        ),
        var(--hero-image)
        center/cover no-repeat;

    display:flex;
    align-items:center;

    overflow:hidden;
}

.hero-content{
    max-width:720px;
    padding:55px;
    color:white;
}

.hero-label{
    color:#e2c275;
    font-size:12px;
    font-weight:700;
    letter-spacing:4px;
}

.hero-title{
    margin:16px 0;

    font-family:"Playfair Display",serif;
    font-size:clamp(42px,6vw,70px);
    line-height:1.05;
}

.hero-description{
    max-width:540px;
    color:#e2e5eb;
    line-height:1.7;
    margin-bottom:25px;
}

.hero-button{
    border:0;
    padding:14px 24px;
    border-radius:30px;

    background:var(--gold);
    color:var(--primary);

    font-weight:700;
    cursor:pointer;

    transition:.2s;
}

.hero-button:hover{
    transform:translateY(-2px);
}

/* =========================
   SECTION
========================= */

.section{
    max-width:1250px;
    margin:45px auto;
    padding:0 20px;
}

.section-head{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:20px;
    margin-bottom:20px;
}

.section-title{
    font-family:"Playfair Display",serif;
    font-size:31px;
}

.section-subtitle{
    color:var(--muted);
    font-size:13px;
}

/* =========================
   CATEGORY
========================= */

.categories{
    display:flex;
    gap:10px;

    overflow-x:auto;
    padding-bottom:5px;

    scrollbar-width:none;
}

.categories::-webkit-scrollbar{
    display:none;
}

.category-btn{
    white-space:nowrap;

    padding:11px 17px;

    border:1px solid var(--line);
    border-radius:17px;

    background:#fff;

    cursor:pointer;

    transition:.2s;
}

.category-btn:hover{
    border-color:var(--gold);
}

.category-btn.active{
    background:var(--primary);
    color:white;
    border-color:var(--primary);
}

/* =========================
   PRODUCT GRID
========================= */

.product-grid{
    display:grid;

    grid-template-columns:
        repeat(4,minmax(0,1fr));

    gap:18px;
}

.product-card{
    background:#fff;

    border:1px solid var(--line);

    border-radius:var(--radius);

    overflow:hidden;

    transition:
        transform .2s,
        box-shadow .2s;
}

.product-card:hover{
    transform:translateY(-5px);

    box-shadow:
        0 20px 45px rgba(0,0,0,.08);
}

.product-image{
    position:relative;

    aspect-ratio:1/1;

    background:#eee;

    overflow:hidden;
}

.product-image img{
    width:100%;
    height:100%;

    object-fit:cover;

    transition:.35s;
}

.product-card:hover .product-image img{
    transform:scale(1.04);
}

.product-label{
    position:absolute;

    top:10px;
    left:10px;

    padding:6px 10px;

    border-radius:20px;

    background:var(--primary);
    color:var(--gold);

    font-size:10px;
    font-weight:700;
}

.product-info{
    padding:14px;
}

.product-category{
    color:#a27b39;

    font-size:10px;

    font-weight:700;

    text-transform:uppercase;

    letter-spacing:.5px;
}

.product-name{
    margin-top:7px;

    min-height:42px;

    font-size:15px;
    font-weight:600;

    line-height:1.4;
}

.rating{
    margin:8px 0;
    font-size:12px;
}

.product-price{
    color:var(--muted);
    font-size:13px;

    margin-bottom:10px;
}

.buy-button{
    display:block;

    width:100%;

    padding:12px;

    border-radius:11px;

    background:var(--primary);
    color:#fff;

    text-align:center;

    font-size:13px;
    font-weight:700;

    transition:.2s;
}

.buy-button:hover{
    background:#27334b;
}

/* =========================
   EMPTY
========================= */

.empty{
    grid-column:1/-1;

    background:#fff;

    border:1px dashed var(--line);

    border-radius:20px;

    padding:50px 20px;

    text-align:center;

    color:var(--muted);
}

/* =========================
   TRUST
========================= */

.trust{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:15px;

    padding:28px;

    border-radius:25px;

    background:var(--primary);

    color:white;
}

.trust-item{
    padding:10px;
}

.trust-icon{
    font-size:24px;
    margin-bottom:8px;
}

.trust-title{
    font-weight:700;
}

.trust-text{
    color:#c8ced8;

    font-size:12px;

    margin-top:5px;

    line-height:1.5;
}

/* =========================
   FOOTER
========================= */

.footer{
    margin-top:70px;

    padding:40px 20px;

    background:#101827;

    color:white;

    text-align:center;
}

.footer-logo{
    font-family:"Playfair Display",serif;
    font-size:25px;
    letter-spacing:3px;
}

.footer-text{
    color:#aeb6c3;
    font-size:12px;
    margin-top:8px;
}

/* =========================
   ADMIN
========================= */

.admin-button{
    position:fixed;

    right:15px;
    bottom:15px;

    z-index:100;

    width:42px;
    height:42px;

    border:0;

    border-radius:50%;

    background:var(--primary);
    color:white;

    cursor:pointer;

    opacity:.18;

    transition:.2s;
}

.admin-button:hover{
    opacity:1;
}

/* =========================
   MOBILE
========================= */

@media(max-width:1000px){

    .product-grid{
        grid-template-columns:
            repeat(3,minmax(0,1fr));
    }

}

@media(max-width:700px){

    .header-inner{
        flex-wrap:wrap;
        gap:10px;
    }

    .logo{
        flex:1;
        min-width:auto;
    }

    .search-box{
        order:3;
        flex-basis:100%;
    }

    .hero{
        padding:0 12px;
    }

    .hero-box{
        min-height:460px;
        border-radius:23px;
    }

    .hero-content{
        padding:30px 25px;
    }

    .hero-title{
        font-size:43px;
    }

    .section{
        padding:0 12px;
    }

    .product-grid{
        grid-template-columns:
            repeat(2,minmax(0,1fr));

        gap:11px;
    }

    .product-info{
        padding:10px;
    }

    .product-name{
        font-size:13px;
        min-height:52px;
    }

    .trust{
        grid-template-columns:1fr;
        padding:20px;
    }

}

</style>

</head>

<body>

<!-- HEADER -->

<header class="header">

<div class="header-inner">

<a href="#" class="logo">

<div class="logo-main">
BAYLOS
</div>

<span class="logo-sub">
SHOPING MURAH
</span>

</a>

<div class="search-box">

<input
type="text"
id="searchInput"
placeholder="Cari produk Baylos..."
autocomplete="off"
>

<button
class="search-btn"
onclick="renderProducts()"
>
⌕
</button>

</div>

</div>

</header>


<!-- HERO -->

<section class="hero">

<div
class="hero-box"
id="heroBox"
>

<div class="hero-content">

<div
class="hero-label"
id="heroLabel"
>
BAYLOS SHOPING MURAH
</div>

<h1
class="hero-title"
id="heroTitle"
>
Fashion Cantik.
<br>
Harga Bersahabat.
</h1>

<p
class="hero-description"
id="heroDescription"
>
Temukan produk pilihan Baylos dengan harga menarik.
</p>

<button
class="hero-button"
onclick="scrollToProducts()"
>
Belanja Sekarang
</button>

</div>

</div>

</section>


<!-- CATEGORY -->

<section class="section">

<div class="section-head">

<h2 class="section-title">
Kategori
</h2>

<span
class="section-subtitle"
>
Pilihan produk Baylos
</span>

</div>

<div
class="categories"
id="categories"
>
</div>

</section>

<!-- PRODUCTS -->

<section
class="section"
id="productsSection"
>

<div class="section-head">

<h2 class="section-title">
Koleksi Pilihan
</h2>

<span
class="section-subtitle"
id="productCount"
>
0 produk
</span>

</div>

<div
class="product-grid"
id="productGrid"
>
</div>

</section>


<!-- TRUST -->

<section class="section">

<div class="trust">

<div class="trust-item">

<div class="trust-icon">
✨
</div>

<div class="trust-title">
Produk Pilihan
</div>

<div class="trust-text">
Produk pilihan yang ditampilkan melalui toko Baylos.
</div>

</div>


<div class="trust-item">

<div class="trust-icon">
💰
</div>

<div class="trust-title">
Harga Menarik
</div>

<div class="trust-text">
Temukan berbagai produk dengan harga yang bersahabat.
</div>

</div>


<div class="trust-item">

<div class="trust-icon">
🛍️
</div>

<div class="trust-title">
Belanja Mudah
</div>

<div class="trust-text">
Klik Beli Sekarang dan langsung menuju produk yang kamu incar.
</div>

</div>

</div>

</section>


<!-- FOOTER -->

<footer class="footer">

<div class="footer-logo">
BAYLOS
</div>

<div class="footer-text">
SHOPING MURAH • PILIHAN PRODUK • BELANJA MUDAH
</div>

<div class="footer-text">
© 2023 Baylos Shoping Murah
</div>

</footer>


<!-- ADMIN -->

<button
class="admin-button"
onclick="openAdmin()"
title="Admin"
>
⚙
</button>


<script>

/* ===================================
   BAYLOS V4 ENGINE
=================================== */

let products = [];

let settings = {};

let selectedCategory = "Semua";


/* ===================================
   DEFAULT HERO
=================================== */

const defaultSettings = {

primary_color:"#172033",

accent_color:"#c9a45c",

background_color:"#f7f5f1",

border_color:"#e8e2d8",

hero_image_url:
"https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1600&q=85",

hero_label:
"BAYLOS SHOPING MURAH",

hero_title:
"Fashion Cantik.\nHarga Bersahabat.",

hero_description:
"Temukan produk pilihan Baylos dengan harga menarik."

};


/* ===================================
   DEMO PRODUCT
   AKAN DIGANTI DATABASE
=================================== */

const demoProducts = [

{

id:"demo-1",

name:"Emilie Blouse Top",

category:"Fashion Wanita",

price:149000,

label:"BEST SELLER",

image_url:
"https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=900&q=85",

affiliate_url:
"https://shop-id.tokopedia.com/view/product/1732323945743156700"

},

{

id:"demo-2",

name:"Premium Casual Shirt",

category:"Fashion Wanita",

price:129000,

label:"TERBARU",

image_url:
"https://images.unsplash.com/photo-1485968579580-b6d095142e6e?auto=format&fit=crop&w=900&q=85",

affiliate_url:"#"

},

{

id:"demo-3",

name:"Elegant Daily Dress",

category:"Dress",

price:179000,

label:"PROMO",

image_url:
"https://images.unsplash.com/photo-1496747611176-843222e1e57c?auto=format&fit=crop&w=900&q=85",

affiliate_url:"#"

}

];


/* ===================================
   ESCAPE HTML
=================================== */

function escapeHTML(value){

return String(value ?? "")

.replace(/[&<>"']/g,function(char){

return {

"&":"&amp;",

"<":"&lt;",

">":"&gt;",

'"':"&quot;",

"'":"&#39;"

}[char];

});

}


/* ===================================
   FORMAT PRICE
=================================== */

function formatPrice(price){

if(
price === null ||
price === undefined ||
price === ""
){

return "Lihat harga terbaru";

}

return new Intl.NumberFormat(
"id-ID",
{

style:"currency",

currency:"IDR",

maximumFractionDigits:0

}
).format(price);

}


/* ===================================
   APPLY THEME
=================================== */

function applySettings(){

const s = {

...defaultSettings,

...settings

};


document.documentElement
.style
.setProperty(
"--primary",
s.primary_color
);


document.documentElement
.style
.setProperty(
"--gold",
s.accent_color
);


document.documentElement
.style
.setProperty(
"--bg",
s.background_color
);


document.documentElement
.style
.setProperty(
"--line",
s.border_color
);


document
.getElementById("heroBox")
.style
.setProperty(
"--hero-image",
`url("${s.hero_image_url}")`
);


document
.getElementById("heroLabel")
.textContent =
s.hero_label;


document
.getElementById("heroTitle")
.innerHTML =
escapeHTML(
s.hero_title
)
.replace(/\n/g,"<br>");


document
.getElementById("heroDescription")
.textContent =
s.hero_description;

}


/* ===================================
   CATEGORY
=================================== */

function renderCategories(){

const categories = [

"Semua",

...new Set(

products

.map(product =>
product.category
)

.filter(Boolean)

)

];


document
.getElementById("categories")
.innerHTML =

categories
.map(category => `

<button

class="category-btn
${category === selectedCategory ? "active" : ""}"

onclick='selectCategory(${JSON.stringify(category)})'

>

${escapeHTML(category)}

</button>

`)
.join("");

}


/* ===================================
   PRODUCTS
=================================== */

function renderProducts(){

const keyword =
document
.getElementById("searchInput")
.value
.toLowerCase()
.trim();


const filtered =
products.filter(product => {

const categoryMatch =

selectedCategory === "Semua" ||

product.category ===
selectedCategory;


const text =

`${product.name || ""} ${product.category || ""}`
.toLowerCase();


const searchMatch =
text.includes(keyword);


return categoryMatch &&
searchMatch;

});


document
.getElementById("productCount")
.textContent =
filtered.length + " produk";


const grid =
document.getElementById("productGrid");


if(!filtered.length){

grid.innerHTML = `

<div class="empty">

<h3>Produk tidak ditemukan</h3>

<p>
Coba gunakan kata kunci lain.
</p>

</div>

`;

return;

}


grid.innerHTML =

filtered
.map(product => `

<article class="product-card">

<div class="product-image">

<img

src="${escapeHTML(product.image_url)}"

alt="${escapeHTML(product.name)}"

loading="lazy"

onerror="this.src='https://placehold.co/800x800?text=Baylos'"

>

${product.label ?

`

<span class="product-label">

${escapeHTML(product.label)}

</span>

`

:

""

}

</div>


<div class="product-info">

<div class="product-category">

${escapeHTML(
product.category || "Produk"
)}

</div>


<div class="product-name">

${escapeHTML(
product.name
)}

</div>


<div class="rating">

⭐⭐⭐⭐⭐

</div>


<div class="product-price">

${formatPrice(
product.price
)}

</div>


<a

class="buy-button"

href="${escapeHTML(
product.affiliate_url
)}"

target="_blank"

rel="noopener noreferrer sponsored nofollow"

onclick="trackProductClick('${escapeHTML(product.id || "")}')"

>

🛒 Beli Sekarang

</a>

</div>

</article>

`)
.join("");

}


/* ===================================
   SELECT CATEGORY
=================================== */

function selectCategory(category){

selectedCategory = category;

renderCategories();

renderProducts();

}


/* ===================================
   SCROLL
=================================== */

function scrollToProducts(){

document
.getElementById("productsSection")
.scrollIntoView({
behavior:"smooth"
});

}


/* ===================================
   ADMIN
=================================== */

function openAdmin(){

window.location.href =
"admin.html";

}


/* ===================================
   CLICK TRACKING
=================================== */

function trackProductClick(id){

console.log(
"Baylos product click:",
id
);

}


/* ===================================
   LOAD DATABASE
=================================== */

async function loadStore(){

try{

const config =
window.BAYLOS_CONFIG || {};


if(

!config.SUPABASE_URL ||

!config.SUPABASE_ANON_KEY ||

config.SUPABASE_URL
.startsWith("ISI_")

){

console.warn(
"Supabase belum dikonfigurasi. Menggunakan produk demo."
);

products =
demoProducts;

settings =
defaultSettings;

applySettings();

renderCategories();

renderProducts();

return;

}


const client =
supabase.createClient(

config.SUPABASE_URL,

config.SUPABASE_ANON_KEY

);


/* PRODUCTS */

const productResult =
await client

.from("products")

.select("*")

.eq("is_active",true)

.order(
"sort_order",
{
ascending:true
}
)

.order(
"created_at",
{
ascending:false
}
);


if(productResult.error){

console.error(
productResult.error
);

products =
demoProducts;

}else{

products =
productResult.data || [];

}


/* SETTINGS */

const settingResult =
await client

.from("store_settings")

.select("*")

.eq("id",1)

.maybeSingle();


if(
settingResult.data
){

settings =
settingResult.data;

}else{

settings =
defaultSettings;

}


/* APPLY */

applySettings();

renderCategories();

renderProducts();


}catch(error){

console.error(error);

products =
demoProducts;

settings =
defaultSettings;

applySettings();

renderCategories();

renderProducts();

}

}


/* ===================================
   SEARCH ENTER
=================================== */

document
.getElementById("searchInput")
.addEventListener(
"keydown",
function(event){

if(event.key === "Enter"){

renderProducts();

}

});


/* ===================================
   START
=================================== */

loadStore();

</script>

</body>
</html>
