<script>

/* =====================================================
   BAYLOS ADMIN V4
===================================================== */

const CONFIG =
window.BAYLOS_CONFIG || {};

let db = null;

let currentUser = null;

let products = [];

let settings = {};

let editingProductId = null;


/* =====================================================
   DEFAULT SETTINGS
===================================================== */

const DEFAULT_SETTINGS = {

primary_color:"#172033",

accent_color:"#c9a45c",

background_color:"#f7f5f1",

border_color:"#e8e2d8",

desktop_columns:4,

card_radius:22,

product_gap:18,

hero_image_url:
"https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1600&q=85",

hero_label:
"BAYLOS SHOPING MURAH",

hero_title:
"Fashion Cantik.\nHarga Bersahabat.",

hero_description:
"Temukan produk pilihan Baylos dengan harga menarik."

};


/* =====================================================
   INIT
===================================================== */

document.addEventListener(
"DOMContentLoaded",
init
);


async function init(){

if(

!CONFIG.SUPABASE_URL ||

!CONFIG.SUPABASE_ANON_KEY ||

CONFIG.SUPABASE_URL.startsWith("ISI_")

){

showLoginError(
"config.js belum dikonfigurasi."
);

return;

}


db =
supabase.createClient(

CONFIG.SUPABASE_URL,

CONFIG.SUPABASE_ANON_KEY

);


const {
data
} =
await db.auth.getSession();


if(data.session){

await enterAdmin(
data.session
);

}else{

showLogin();

}


db.auth.onAuthStateChange(
async (event, session)=>{

if(event === "SIGNED_IN" && session){

await enterAdmin(session);

}

if(event === "SIGNED_OUT"){

showLogin();

}

}

);

}


/* =====================================================
   LOGIN
===================================================== */

document
.getElementById("loginForm")
.addEventListener(
"submit",
async function(event){

event.preventDefault();

const email =
document
.getElementById("loginEmail")
.value
.trim();

const password =
document
.getElementById("loginPassword")
.value;


const button =
this.querySelector("button");

button.disabled = true;

button.textContent =
"Memproses...";


const {
data,
error
} =
await db.auth.signInWithPassword({

email:email,

password:password

});


button.disabled = false;

button.textContent =
"Masuk ke Dashboard";


if(error){

showLoginError(
error.message
);

return;

}


await enterAdmin(data.session);

}
);


/* =====================================================
   ENTER ADMIN
===================================================== */

async function enterAdmin(session){

currentUser =
session.user;


document
.getElementById("loginScreen")
.classList
.add("hidden");


document
.getElementById("app")
.classList
.remove("hidden");


document
.getElementById("userEmail")
.textContent =
currentUser.email;


document
.getElementById("currentAdminEmail")
.value =
currentUser.email;


await loadProducts();

await loadSettings();

showPage("dashboard");

}


/* =====================================================
   LOGIN ERROR
===================================================== */

function showLoginError(message){

const box =
document
.getElementById("loginError");

box.textContent =
message;

box.classList
.remove("hidden");

}


/* =====================================================
   SHOW LOGIN
===================================================== */

function showLogin(){

document
.getElementById("loginScreen")
.classList
.remove("hidden");

document
.getElementById("app")
.classList
.add("hidden");

}


/* =====================================================
   NAVIGATION
===================================================== */

document
.querySelectorAll(".menu button[data-page]")
.forEach(button=>{

button.addEventListener(
"click",
()=>{

showPage(
button.dataset.page
);

}

);

});


function showPage(page){

document
.querySelectorAll(".admin-page")
.forEach(section=>{

section.classList
.add("hidden");

});


const target =
document
.getElementById(
"page-"+page
);

if(target){

target.classList
.remove("hidden");

}


document
.querySelectorAll(".menu button[data-page]")
.forEach(button=>{

button.classList.toggle(
"active",
button.dataset.page === page
);

});


const titles = {

dashboard:"Dashboard",

products:"Produk",

"add-product":
"Tambah / Edit Produk",

theme:"Tampilan Toko",

settings:"Pengaturan"

};


document
.getElementById("pageTitle")
.textContent =
titles[page] || "Admin";


if(page === "products"){

renderProductTable();

}

if(page === "theme"){

fillThemeForm();

}

if(page === "add-product"){

if(!editingProductId){

resetProductForm();

}

}


document
.getElementById("sidebar")
.classList
.remove("open");

}


/* =====================================================
   SIDEBAR MOBILE
===================================================== */

function toggleSidebar(){

document
.getElementById("sidebar")
.classList
.toggle("open");

}


/* =====================================================
   LOAD PRODUCTS
===================================================== */

async function loadProducts(){

const {
data,
error
} =
await db
.from("products")
.select("*")
.order(
"sort_order",
{
ascending:true
}
)
.order(
"created_at",
{
ascending:false
}
);


if(error){

toast(
"Produk gagal dimuat: "+
error.message,
"error"
);

return;

}


products =
data || [];


updateStats();

renderProductTable();

}


/* =====================================================
   STATS
===================================================== */

function updateStats(){

document
.getElementById("totalProducts")
.textContent =
products.length;


document
.getElementById("activeProducts")
.textContent =

products.filter(
p=>p.is_active
).length;


const categories =
new Set(

products
.map(p=>p.category)
.filter(Boolean)

);


document
.getElementById("totalCategories")
.textContent =
categories.size;

}


/* =====================================================
   RENDER PRODUCTS
===================================================== */

function renderProductTable(){

const table =
document
.getElementById("productTable");


if(!products.length){

table.innerHTML = `

<tr>

<td colspan="7">

<div class="loading">

Belum ada produk.

<br><br>

<button
class="btn btn-primary"
onclick="showPage('add-product')"
>
+ Tambah Produk
</button>

</div>

</td>

</tr>

`;

return;

}


table.innerHTML =

products
.map(product=>{

const image =
product.image_url ||
"https://placehold.co/100x100?text=Baylos";


const status =
product.is_active

?

`<span
class="badge"
style="background:#e7f7f0;color:#16835b"
>
AKTIF
</span>`

:

`<span
class="badge"
style="background:#fff0ef;color:#c0392b"
>
NONAKTIF
</span>`;


const label =
product.label

?

`<span
class="badge"
style="background:#f7f0df;color:#987332"
>
${escapeHTML(product.label)}
</span>`

:

"-";


return `

<tr>

<td>

<img
class="product-thumb"
src="${escapeHTML(image)}"
onerror="this.src='https://placehold.co/100x100?text=Baylos'"
>

</td>


<td>

<strong>
${escapeHTML(product.name)}
</strong>

</td>


<td>

${escapeHTML(
product.category || "-"
)}

</td>


<td>

${formatPrice(
product.price
)}

</td>


<td>

${label}

</td>


<td>

${status}

</td>


<td>

<div class="actions">

<button
class="btn btn-secondary"
onclick="editProduct('${product.id}')"
>
Edit
</button>

<button
class="btn btn-danger"
onclick="deleteProduct('${product.id}')"
>
Hapus
</button>

</div>

</td>

</tr>

`;

})
.join("");

}


/* =====================================================
   ADD PRODUCT
===================================================== */

document
.getElementById("productForm")
.addEventListener(
"submit",
saveProduct
);


async function saveProduct(event){

event.preventDefault();


const name =
document
.getElementById("productName")
.value
.trim();


const category =
document
.getElementById("productCategory")
.value
.trim();


const affiliateUrl =
document
.getElementById("affiliateUrl")
.value
.trim();


if(!name){

toast(
"Nama produk wajib diisi.",
"error"
);

return;

}


if(!category){

toast(
"Kategori wajib diisi.",
"error"
);

return;

}


if(!affiliateUrl){

toast(
"Link affiliate wajib diisi.",
"error"
);

return;

}


const button =
event.target
.querySelector(
"button[type=submit]"
);


button.disabled = true;

button.textContent =
"Menyimpan...";


try{

let finalImageUrl =
document
.getElementById("imageUrl")
.value
.trim();


const file =
document
.getElementById("imageFile")
.files[0];


if(file){

finalImageUrl =
await uploadImage(file);

}


if(!finalImageUrl){

finalImageUrl =
"https://placehold.co/800x800?text=Baylos";

}


const payload = {

name:name,

category:category,

price:
Number(
document
.getElementById("productPrice")
.value
) || null,

label:
document
.getElementById("productLabel")
.value || null,

affiliate_url:
affiliateUrl,

image_url:
finalImageUrl,

description:
document
.getElementById("productDescription")
.value
.trim() || null,

sort_order:
Number(
document
.getElementById("sortOrder")
.value
) || 0,

is_active:
document
.getElementById("productActive")
.value === "true"

};


let result;


if(editingProductId){

result =
await db
.from("products")
.update(payload)
.eq("id",editingProductId);

}else{

result =
await db
.from("products")
.insert(payload);

}


if(result.error){

throw result.error;

}


toast(
editingProductId
?
"Produk berhasil diperbarui."
:
"Produk berhasil ditambahkan.",
"success"
);


await loadProducts();

resetProductForm();

showPage("products");


}catch(error){

console.error(error);

toast(
"Gagal menyimpan: "+
error.message,
"error"
);

}


button.disabled = false;

button.textContent =
"💾 Simpan Produk";

}


/* =====================================================
   EDIT PRODUCT
===================================================== */

function editProduct(id){

const product =
products.find(
p=>p.id === id
);


if(!product){

toast(
"Produk tidak ditemukan.",
"error"
);

return;

}


editingProductId =
id;


document
.getElementById("productFormTitle")
.textContent =
"Edit Produk";


document
.getElementById("productId")
.value =
product.id;


document
.getElementById("productName")
.value =
product.name || "";


document
.getElementById("productCategory")
.value =
product.category || "";


document
.getElementById("productPrice")
.value =
product.price || "";


document
.getElementById("productLabel")
.value =
product.label || "";


document
.getElementById("affiliateUrl")
.value =
product.affiliate_url || "";


document
.getElementById("imageUrl")
.value =
product.image_url || "";


document
.getElementById("productDescription")
.value =
product.description || "";


document
.getElementById("sortOrder")
.value =
product.sort_order || 0;


document
.getElementById("productActive")
.value =
String(
product.is_active
);


const preview =
document
.getElementById("imagePreview");


if(product.image_url){

preview.src =
product.image_url;

preview.style.display =
"block";

}else{

preview.style.display =
"none";

}


showPage(
"add-product"
);

}


/* =====================================================
   RESET FORM
===================================================== */

function resetProductForm(){

editingProductId =
null;


document
.getElementById("productForm")
.reset();


document
.getElementById("productId")
.value =
"";


document
.getElementById("productFormTitle")
.textContent =
"Tambah Produk";


document
.getElementById("sortOrder")
.value =
"0";


document
.getElementById("productActive")
.value =
"true";


document
.getElementById("imagePreview")
.style
.display =
"none";

}


/* =====================================================
   DELETE PRODUCT
===================================================== */

async function deleteProduct(id){

const product =
products.find(
p=>p.id === id
);


if(!product){

return;

}


const confirmed =
confirm(

`Hapus produk "${product.name}"?

Produk akan dihapus dari database.`

);


if(!confirmed){

return;

}


const {
error
} =
await db
.from("products")
.delete()
.eq("id",id);


if(error){

toast(
"Gagal menghapus: "+
error.message,
"error"
);

return;

}


toast(
"Produk berhasil dihapus.",
"success"
);


await loadProducts();

}


/* =====================================================
   UPLOAD IMAGE
===================================================== */

async function uploadImage(file){

if(!file){

return null;

}


if(!file.type.startsWith("image/")){

throw new Error(
"File harus berupa gambar."
);

}


if(file.size > 5 * 1024 * 1024){

throw new Error(
"Ukuran gambar maksimal 5 MB."
);

}


const extension =
file.name
.split(".")
.pop()
.toLowerCase();


const filename =

`${Date.now()}-${crypto.randomUUID()}.${extension}`;


const path =
"products/"+filename;


const {
error
} =
await db
.storage
.from("product-images")
.upload(
path,
file,
{
cacheControl:"3600",
upsert:false
}
);


if(error){

throw error;

}


const {
data
} =
db
.storage
.from("product-images")
.getPublicUrl(path);


return data.publicUrl;

}


/* =====================================================
   IMAGE PREVIEW
===================================================== */

document
.getElementById("imageFile")
.addEventListener(
"change",
function(){

const file =
this.files[0];


if(!file){

return;

}


const preview =
document
.getElementById("imagePreview");


preview.src =
URL.createObjectURL(file);

preview.style.display =
"block";

}
);


/* =====================================================
   LOAD SETTINGS
===================================================== */

async function loadSettings(){

const {
data,
error
} =
await db
.from("store_settings")
.select("*")
.eq("id",1)
.maybeSingle();


if(error){

console.error(error);

settings =
{
...DEFAULT_SETTINGS
};

return;

}


settings =
{
...DEFAULT_SETTINGS,
...(data || {})
};


fillThemeForm();

}


