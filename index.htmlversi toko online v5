<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no"/>
<title>Toko Online</title>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<link rel="stylesheet" href="styles.css"/>
</head>
<body>

<div class="topbar">
  <div class="logo"><span class="icon" id="storeEmoji">🛍️</span><span id="storeNameTop">Baylos</span></div>
  <div class="search">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
    <input id="searchInput" placeholder="Cari produk..." oninput="renderProducts()">
  </div>
  <button class="icon-btn" id="themeBtn" onclick="toggleTheme()">🌙</button>
  <button class="icon-btn" onclick="goPage('keranjang')">🛒<span class="badge" id="cartBadge">0</span></button>
</div>

<div class="page active" id="page-beranda">
  <div class="flashbar" id="flashBanner">
    <div><h3 id="flashTitle">⚡ Flash Sale!</h3><p id="flashInfo"></p></div>
    <div class="timer" id="flashTimer"></div>
  </div>
  <div class="cats" id="cats"></div>
  <div class="toolbar">
    <div><h2>Produk</h2><small id="resultInfo"></small></div>
    <select class="sort-sel" id="sortSel" onchange="renderProducts()">
      <option value="baru">Terbaru</option>
      <option value="murah">Harga Terendah</option>
      <option value="mahal">Harga Tertinggi</option>
      <option value="nama">Nama A-Z</option>
      <option value="laris">Terlaris</option>
    </select>
  </div>
  <div class="grid" id="productGrid"></div>
</div>

<div class="page" id="page-keranjang">
  <div class="toolbar"><h2>🛒 Keranjang</h2></div>
  <div style="padding:0 16px" id="cartList"></div>
  <div style="padding:0 16px">
    <div class="summary-box" id="cartSummary"></div>
    <button class="big-btn" onclick="goCheckout()">Checkout Sekarang →</button>
  </div>
</div>

<div class="page" id="page-pesanan">
  <div class="toolbar"><h2>📦 Pesanan Saya</h2>
    <small style="color:var(--text-dim)">Tap untuk detail & lacak</small></div>
  <div style="padding:0 16px" id="orderList"></div>
</div>

<div class="page" id="page-profil">
  <div class="toolbar"><h2>👤 Akun Saya</h2></div>
  <div style="padding:0 16px" id="profileContent"></div>
</div>

<nav class="bnav">
  <button class="active" data-page="beranda" onclick="goPage('beranda')"><span class="em">🏠</span>Beranda</button>
  <button data-page="keranjang" onclick="goPage('keranjang')"><span class="em">🛒</span>Keranjang</button>
  <button data-page="pesanan" onclick="goPage('pesanan')"><span class="em">📦</span>Pesanan</button>
  <button data-page="profil" onclick="goPage('profil')"><span class="em">👤</span>Akun</button>
</nav>

<!-- DETAIL PRODUK -->
<div class="modal" id="detailModal"><div class="sheet">
  <div class="sheet-head"><h2>Detail Produk</h2><button class="x-btn" onclick="closeModal('detailModal')">✕</button></div>
  <div id="detailContent"></div>
</div></div>

<!-- CHECKOUT -->
<div class="modal" id="checkoutModal"><div class="sheet">
  <div class="sheet-head"><h2>💳 Checkout</h2><button class="x-btn" onclick="closeModal('checkoutModal')">✕</button></div>
  <div id="checkoutContent"></div>
</div></div>

<!-- PETA ALAMAT -->
<div class="modal" id="mapModal"><div class="sheet" style="max-height:100%">
  <div class="sheet-head"><h2>📍 Pin Lokasi Alamat</h2><button class="x-btn" onclick="closeModal('mapModal')">✕</button></div>
  <p style="font-size:.78rem;color:var(--text-dim);margin-bottom:10px">
    Geser pin ke titik rumah kamu (atau tekan "📍 Lokasi GPS Saya"). Alamat diambil otomatis dari titik peta.</p>
  <div id="map" style="height:320px;border-radius:14px"></div>
  <div id="mapAddr" style="font-size:.8rem;margin:10px 0;color:var(--text);font-weight:600">Pin lokasi belum dipilih</div>
  <div class="field"><label>Catatan / Patokan (opsional)</label>
    <input type="text" id="addrNote" placeholder="misal: Rumah pagi warna biru, sebelah masjid"></div>
  <div style="display:flex;gap:8px">
    <button class="big-btn" style="background:var(--surface-2);color:var(--text);box-shadow:none" onclick="gpsLocate()">📍 GPS Saya</button>
    <button class="big-btn" onclick="saveMapAddress()">✔ Gunakan Titik Ini</button>
  </div>
</div></div>

<!-- EDIT PROFIL -->
<div class="modal" id="editProfilModal"><div class="sheet" style="max-height:100%">
  <div class="sheet-head"><h2>✏️ Edit Profil</h2><button class="x-btn" onclick="closeModal('editProfilModal')">✕</button></div>
  <div class="login-box" style="margin:0">
    <div class="avatar-edit">
      <img id="editAvaImg" class="profile-ava" style="width:80px;height:80px" alt="avatar">
      <label class="ava-upload-btn" for="avaInput">📷 Ubah Foto</label>
      <input type="file" id="avaInput" accept="image/*" style="display:none" onchange="pickAvatar(event)">
      <button type="button" class="ava-remove" onclick="removeAvatar()">Hapus Foto</button>
    </div>
    <div class="field"><label>Nama Lengkap</label><input type="text" id="editNama"></div>
    <div class="field"><label>No. HP</label><input type="text" id="editPhone" placeholder="08xxxxxxxxxx"></div>
    <div class="field"><label>Email</label><input type="email" id="editEmail"></div>
    <div class="field"><label>Username</label><input type="text" id="editUsername" disabled style="opacity:.6"></div>
    <div class="field"><label>Alamat Pengiriman (via Peta GPS)</label>
      <div id="addrPreview" style="font-size:.8rem;background:var(--surface-2);padding:10px 12px;border-radius:10px;margin-bottom:8px">Belum ada alamat</div>
      <button type="button" class="big-btn" style="margin:0 0 4px" onclick="openMapPicker()">📍 Pilih / Ubah Alamat di Peta</button></div>
    <button class="big-btn" onclick="saveProfilEdit()">💾 Simpan Perubahan</button>
  </div>
</div></div>

<!-- GANTI PASSWORD -->
<div class="modal" id="passModal"><div class="sheet">
  <div class="sheet-head"><h2>🔑 Ganti Password</h2><button class="x-btn" onclick="closeModal('passModal')">✕</button></div>
  <div class="login-box" style="margin:0">
    <div class="field"><label>Password Lama</label><input type="password" id="passLama"></div>
    <div class="field"><label>Password Baru (min. 6)</label><input type="password" id="passBaru"></div>
    <div class="field"><label>Konfirmasi Password Baru</label><input type="password" id="passBaru2"></div>
    <button class="big-btn" onclick="changePass()">Simpan Password</button>
  </div>
</div></div>

<!-- BUKTI TRANSFER -->
<div class="modal" id="buktiModal"><div class="sheet">
  <div class="sheet-head"><h2>🧾 Upload Bukti Transfer</h2><button class="x-btn" onclick="closeModal('buktiModal')">✕</button></div>
  <div class="login-box" style="margin:0;text-align:center">
    <div id="buktiPreview" style="min-height:140px;border:2px dashed var(--border);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;color:var(--text-dim);font-size:.8rem">
      Belum ada gambar</div>
    <label class="ava-upload-btn" for="buktiInput" style="display:inline-block">📷 Pilih Foto Bukti Transfer</label>
    <input type="file" id="buktiInput" accept="image/*" style="display:none" onchange="pickBukti(event)">
    <button class="big-btn" id="buktiSubmit" disabled onclick="submitBukti()">✅ Kirim & Selesaikan Pesanan</button>
    <p style="font-size:.7rem;color:var(--text-dim);margin-top:10px">Pesanan diproses setelah admin verifikasi pembayaran.</p>
  </div>
</div></div>

<div class="success-pop" id="successPop"><div>
  <div class="check">✓</div>
  <h2 style="margin-bottom:8px">Pesanan Dibuat!</h2>
  <p id="successMsg" style="color:var(--text-dim);font-size:.88rem;margin-bottom:24px"></p>
  <button class="big-btn" style="max-width:250px" onclick="closeSuccess()">Lihat Pesanan Saya</button>
</div></div>

<div class="toast" id="toast"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="script.js"></script>
</body>
</html>
